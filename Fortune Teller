#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <string.h>

// Define a linked list node to store fortunes
typedef struct Node {
    char fortune[256];
    struct Node* next;
} Node;

// Function to create a new node
Node* createNode(const char* fortune) {
    Node* newNode = (Node*)malloc(sizeof(Node));
    strcpy(newNode->fortune, fortune);
    newNode->next = NULL;
    return newNode;
}

// Function to add a fortune to the linked list
void addFortune(Node** head, const char* fortune) {
    Node* newNode = createNode(fortune);
    if (*head == NULL) {
        *head = newNode;
        return;
    }
    Node* temp = *head;
    while (temp->next != NULL) {
        temp = temp->next;
    }
    temp->next = newNode;
}

// Function to get a random fortune from a linked list
void getFortune(Node* head) {
    int count = 0;
    Node* temp = head;

    // Count the number of nodes
    while (temp != NULL) {
        count++;
        temp = temp->next;
    }

    if (count == 0) {
        printf("No fortunes available.\n");
        return;
    }

    // Generate a random number
    int randomIndex = rand() % count;

    // Traverse to the random index
    temp = head;
    for (int i = 0; i < randomIndex; i++) {
        temp = temp->next;
    }

    // Print the fortune
    printf("Your fortune: %s\n", temp->fortune);
}

