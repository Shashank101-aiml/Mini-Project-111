    printf("Choose your astrological sign:\n");
    printf("1. Aries\n2. Taurus\n3. Gemini\n4. Cancer\n5. Leo\n6. Virgo\n");
    printf("7. Libra\n8. Scorpio\n9. Sagittarius\n10. Capricorn\n");
    printf("11. Aquarius\n12. Pisces\n");
}

int main() {
    Node *careerList = NULL, *loveList = NULL, *healthList = NULL, *generalList = NULL;

    // Seed the random number generator
    srand(time(0));

    // Populate fortunes for different fields
    defineFortunes(&careerList, &loveList, &healthList, &generalList);

    // User interaction
    char name[50];
    int day, month, signOption;
    char* astrologicalSigns[] = {"Aries", "Taurus", "Gemini", "Cancer", "Leo", "Virgo", "Libra", "Scorpio", "Sagittarius", "Capricorn", "Aquarius", "Pisces"};

    printf("Welcome to the Fortune Teller!\n");
    printf("Enter your name: ");
    scanf("%s", name);

    printf("Enter your date of birth (DD MM): ");
    scanf("%d %d", &day, &month);

    // Display and choose astrological sign
    displayAstrologicalSigns();
    printf("Enter the number corresponding to your astrological sign: ");
    scanf("%d", &signOption);

    if (signOption < 1 || signOption > 12) {
        printf("Invalid choice.\n");
        return 1;
    }

    printf("\nHello, %s! Based on your sign (%s) and birthday (%d/%d):\n", name, astrologicalSigns[signOption - 1], day, month);

    // Get multiple random fortunes for different fields
    printf("\nCareer Fortune:\n");
    getFortune(careerList);
    printf("\nLove Fortune:\n");
    getFortune(loveList);
    printf("\nHealth Fortune:\n");
    getFortune(healthList);
    printf("\nGeneral Advice:\n");
    getFortune(generalList);

    return 0;
}
